# ═════════════════════════════════════════════════════════════════════════════
# Threat Intelligence — environment template
#
#   Local:  cp .env.example .env    then fill in the values below.
#   Server: use this as the systemd EnvironmentFile (see deploy/DEPLOY.md).
#
# A real environment variable always overrides the .env file, so you can layer
# AWS Secrets Manager / systemd on top without editing anything here.
# NOTE: .env is gitignored. .env.example (this file) is committed, so never put
# a real password or a real address in it.
# ═════════════════════════════════════════════════════════════════════════════

# ── Deployment mode ──────────────────────────────────────────────────────────
# development | production
# production tightens the defaults: HTTPS-only session cookies, no wildcard
# Socket.IO origins, no "password" as the bootstrap admin credential, and a
# startup check that refuses to silently ship broken email links.
TI_ENV=production

# All scheduling and display uses this zone. Without it, APScheduler falls back
# to the machine's local timezone — IST on a laptop, UTC on a default EC2 box,
# a silent 5h30m shift in when the scrape and SOC delivery fire.
TI_TIMEZONE=Asia/Kolkata

# ── Public URLs ──────────────────────────────────────────────────────────────
# THE MOST IMPORTANT SETTING. This is the base URL written into the Approve /
# Reject buttons in emails, and it is resolved in the RECIPIENT's browser. If it
# says localhost, every recipient's browser looks at their own machine and the
# buttons do nothing — the whole approval workflow silently dies.
# Must be reachable by everyone who receives mail. HTTPS in production.
TI_PUBLIC_BASE_URL=https://threatintel.internal.example.com

# Public URL of the dashboard, if it is served on a different host/path from the
# callback endpoints. Defaults to TI_PUBLIC_BASE_URL when unset.
#TI_DASHBOARD_PUBLIC_URL=https://threatintel.internal.example.com

# ── Bind addresses ───────────────────────────────────────────────────────────
# The interface each server listens on — a different thing from the public URL.
#   127.0.0.1  only this machine can connect. Correct when nginx proxies.
#   0.0.0.0    anyone the security group allows can connect.
# 127.0.0.1 was previously hardcoded, which on a server means nobody can reach
# the dashboard at all.
TI_DASHBOARD_BIND_HOST=127.0.0.1
TI_DASHBOARD_PORT=5001
TI_CALLBACK_BIND_HOST=127.0.0.1
TI_CALLBACK_PORT=5000

# Loopback URL our own background processes use to push events to the dashboard.
#TI_INTERNAL_DASHBOARD_URL=http://127.0.0.1:5001

# ── Reverse proxy ────────────────────────────────────────────────────────────
# Number of proxies in front of the app. 0 = none. Set to 1 behind a single
# nginx or ALB so the app resolves the real client IP from X-Forwarded-For.
# Never set it higher than the actual number of proxies: the extra hops let a
# client forge its own IP by sending its own X-Forwarded-For header.
TI_TRUSTED_PROXY_HOPS=1

# Origins allowed to open a Socket.IO connection (comma-separated). Defaults to
# the dashboard's own origin in production. "*" would let any site a signed-in
# user visits open an authenticated socket.
#TI_CORS_ORIGINS=https://threatintel.internal.example.com

# ── Access control ───────────────────────────────────────────────────────────
# Company domains permitted to sign in (comma-separated). Fails closed.
TI_ALLOWED_EMAIL_DOMAINS=example.com

# Accounts always treated as admin regardless of stored role, so the platform
# owner cannot be locked out. Comma-separated. Empty by default.
TI_BOOTSTRAP_SUPER_ADMINS=security.lead@example.com

# The local admin seeded on a brand-new database.
TI_DEFAULT_ADMIN_EMAIL=admin@example.com
# Bootstrap password. If unset in production, a random one is generated and
# written to .initial_admin_password (0600) — read it, log in, change it, delete
# the file. Never leave this as "password" on a networked host.
TI_DEFAULT_ADMIN_PASSWORD=

# ── Brute-force throttle ─────────────────────────────────────────────────────
# Failed sign-ins are counted per client IP and per targeted account. After
# TI_LOGIN_FAIL_MAX failures inside TI_LOGIN_FAIL_WINDOW seconds, that IP and
# that account are refused with HTTP 429 for TI_LOGIN_LOCKOUT seconds. A
# successful sign-in clears the counters. The same limits also cover the
# access-request form and the self-service password change, each on its own
# counter. Defaults below; raise the max if a shared office NAT trips it.
TI_LOGIN_FAIL_MAX=8
TI_LOGIN_FAIL_WINDOW=900
TI_LOGIN_LOCKOUT=900

# ── Email credentials ────────────────────────────────────────────────────────
# Set these on a server so no secret is written into admin_settings.json.
# Anything set here CANNOT be edited from the /admin panel (the panel writes the
# JSON file, which the environment then overrides) — that is deliberate for
# credentials, and the panel shows such fields as locked.
TI_SENDER_EMAIL=
TI_SENDER_PASSWORD=
TI_MANAGER_EMAIL=
TI_VALIDATOR_EMAIL=
TI_SOC_EMAIL=
TI_SMTP_SERVER=smtp.gmail.com
TI_SMTP_PORT=587
#TI_COMPANY_NAME=Your Company

# Set to 0 to silence access-request emails while keeping the in-app badge.
# Useful on a staging box.
#ACCESS_REQUEST_EMAIL=1

# ── Storage ──────────────────────────────────────────────────────────────────
# Absolute path to the SQLite database. Point this OUTSIDE the code directory in
# production so redeploying the code cannot overwrite live data.
# Keep it on a local disk — SQLite's file locking is not reliable over NFS/EFS.
TI_DATABASE_PATH=/var/lib/threatintel/threat_intel.db

# ── Logging ──────────────────────────────────────────────────────────────────
TI_LOG_DIR=/var/log/threatintel
TI_LOG_LEVEL=INFO
# Disk ceiling per component is MAX_MB × (BACKUPS + 1) — 20 MB at these values,
# across the 'dashboard' and 'callback' logs. Raise where disk is cheap.
TI_LOG_MAX_MB=5
TI_LOG_BACKUPS=3

# ── Data retention ───────────────────────────────────────────────────────────
# Swept nightly at 03:40 local by the scheduler, which then VACUUMs so the
# freed pages actually leave the disk. Run it on demand from the dashboard's
# admin maintenance panel (target: retention_sweep).

# Logs and rejected articles — disposable once read.
TI_LOG_RETENTION_DAYS=90

# The audit trail: soc_deliveries, manager_approvals, sender_validations —
# "who approved this and when did it ship". Deliberately long. Deliveries still
# pending/scheduled are never swept, however old, so queued sends are safe.
TI_AUDIT_RETENTION_DAYS=365

# Scrape bookkeeping: scraping_sessions and their per-article join rows.
TI_SESSION_RETENTION_DAYS=90

# After this many days the full scraped article BODY is blanked — the row,
# title, URL, score and every audit row pointing at it are kept. This column is
# the largest thing in the database, so this is the setting that actually
# controls growth. Set 0 to keep bodies forever.
TI_ARTICLE_CONTENT_RETENTION_DAYS=180

# ── Firebase (browser sign-in) ───────────────────────────────────────────────
# These are web client identifiers, shipped to every browser by design, so they
# are not secrets — but keeping them configurable lets you point a fork at your
# own Firebase project. Remember to add the server's hostname to the Firebase
# console's Authorized Domains, or sign-in will fail.
#TI_FIREBASE_API_KEY=
#TI_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
#TI_FIREBASE_PROJECT_ID=your-project
#TI_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
#TI_FIREBASE_MESSAGING_SENDER_ID=
#TI_FIREBASE_APP_ID=

# ── Branding ─────────────────────────────────────────────────────────────────
# The dashboard's logo, wordmark, favicon and email accent colour. Unset, the
# app uses the neutral shield mark and the name below — which is what a fresh
# clone gets, so the repository never carries a company's visual identity.
#
# To brand a deployment, copy your own SVGs into static/ as brand-logo.svg (wide
# wordmark) and brand-icon.svg (square mark / favicon) — both names are
# gitignored — then uncomment these. The files must be deployed alongside the
# code; `git clone` will not bring them.
#TI_BRAND_NAME=Your Company
#TI_BRAND_LOGO=/static/brand-logo.svg
#TI_BRAND_ICON=/static/brand-icon.svg
# Hex only (#RGB / #RRGGBB). An unparseable value falls back to the default.
#TI_BRAND_COLOR=#2F6BFF

# ── Remote inference (split deployment only) ─────────────────────────────────
# Leave these unset for local development and for a single-box deployment: the
# summarisation and sentence-ranking models then load in-process, as they always
# have. Set them to move just those two models onto a separate host — see
# deploy/SPLIT-DEPLOYMENT.md.
#
# The private address of the inference box. Over a Lightsail↔VPC peering
# connection this is an RFC1918 address and the traffic never leaves AWS, so
# plain HTTP is accepted. A hostname or public IP must use HTTPS — startup
# refuses otherwise in production, because the bearer token below would
# otherwise cross the internet in clear text.
#TI_INFERENCE_URL=http://172.31.20.10:5002

# Shared secret, sent as `Authorization: Bearer <token>`. The inference service
# has NO other authentication — anyone who can reach the port and present this
# can use the models. Generate with `openssl rand -hex 32`; it must match
# TI_INFERENCE_TOKEN in /etc/threatintel/inference.env on the model box.
# Setting TI_INFERENCE_URL without this refuses to start.
#TI_INFERENCE_TOKEN=

# Seconds to wait for one call. The default absorbs a 30-60s cold model load on
# the inference box's first request after a restart.
#TI_INFERENCE_TIMEOUT=120

# Circuit breaker. After this many consecutive failures the app stops calling the
# inference service and writes non-AI summaries for the cooldown window, then
# retries. Without it, an inference box that is down turns a 50-article scrape
# into 50 sequential 120s timeouts — 100 minutes to produce the same output the
# fallback gives instantly. Any success resets the counter.
#TI_INFERENCE_FAILURE_LIMIT=3
#TI_INFERENCE_COOLDOWN=300

# ── AI model cache (deployed hosts only) ─────────────────────────────────────
# Where transformers/sentence-transformers cache the ~1.7 GB of model weights.
# Not a TI_* setting — it is HuggingFace's own variable — but a deployment needs
# it, because the default path is wrong under systemd.
#
# The service account's home is the code directory (/opt/threatintel), so the
# default cache lands there; both systemd units set ProtectSystem=strict, which
# makes that directory read-only at runtime. The download then fails,
# _ai_available flips to False for the life of the process, and reports quietly
# fall back to non-AI summaries until someone restarts the service.
#
# On a server, point this somewhere inside the units' ReadWritePaths and
# pre-warm the cache with the same value set — see
# deploy/AWS-DEPLOYMENT-PLAN.md §3.3. Leave unset for local development, where
# your own home directory is writable.
#HF_HOME=/var/lib/threatintel/huggingface

# ── Debug ────────────────────────────────────────────────────────────────────
# NEVER enable on a networked host. Werkzeug's debugger turns any unhandled
# exception into an interactive Python console in the browser — remote code
# execution. Ignored entirely when TI_ENV=production.
#TI_CALLBACK_DEBUG=0
